# ==============================================================================
# ReachInbox Email Scheduler - Production & Development Env Template
# ==============================================================================

# Application Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=a_very_secure_random_session_secret_key_32_chars_long
LOG_LEVEL=info

# Database (PostgreSQL)
# Use your Neon PostgreSQL connection string in production
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox

# Redis (Queue and Rate Limiting)
# For local development:
REDIS_HOST=localhost
REDIS_PORT=6379
# For production (Upstash Redis). If set, REDIS_URL takes precedence over HOST/PORT:
# REDIS_URL=rediss://default:your_upstash_password@your_upstash_host.upstash.io:6379

# Elasticsearch (Email Search Index)
ELASTICSEARCH_URL=http://localhost:9200
# Optional credentials for managed/secured cloud Elasticsearch service:
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=your_secure_elasticsearch_password
# ELASTICSEARCH_API_KEY=your_elasticsearch_api_key

# Concurrency & Flow Control
WORKER_CONCURRENCY=10
MIN_SEND_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=50

# Google OAuth Credentials (Obtain from Google Cloud Console Developer Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Slack OAuth Credentials (Obtain from Slack API Console app credentials)
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback

# Ethereal Email Credentials (optional - auto-generated if blank)
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# ==============================================================================
# FRONTEND CONFIGURATION
# ==============================================================================
# In Vercel, inject this variable to point to your Railway backend:
# VITE_API_URL=https://your-backend-service.up.railway.app
