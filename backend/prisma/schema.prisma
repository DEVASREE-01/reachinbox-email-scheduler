datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  RATE_LIMITED
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  googleId        String           @unique
  name            String
  email           String           @unique
  avatar          String
  senders         Sender[]
  campaigns       Campaign[]
  slackConnection SlackConnection?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Sender {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String
  smtpHost     String
  smtpPort     Int
  smtpUser     String
  smtpPassword String
  campaigns    Campaign[]
  emails       Email[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userId])
}

model Campaign {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderId    String   @db.Uuid
  sender      Sender   @relation(fields: [senderId], references: [id], onDelete: Cascade)
  subject     String
  body        String
  startTime   DateTime
  delayMs     Int
  hourlyLimit Int
  emails      Email[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Email {
  id           String      @id @default(uuid()) @db.Uuid
  campaignId   String      @db.Uuid
  campaign     Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  senderId     String      @db.Uuid
  sender       Sender      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  recipient    String
  subject      String
  body         String
  scheduledAt  DateTime
  sentAt       DateTime?
  status       EmailStatus @default(SCHEDULED)
  attempts     Int         @default(0)
  bullJobId    String      @unique
  messageId    String?
  errorMessage String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([recipient])
  @@index([status])
  @@index([scheduledAt])
  @@index([sentAt])
  @@index([senderId])
  @@index([campaignId])
}

model SlackConnection {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String
  teamId      String
  teamName    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
